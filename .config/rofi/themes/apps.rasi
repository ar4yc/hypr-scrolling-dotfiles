* {
    selected-normal-foreground:  rgba(249,249,249,1);
    foreground:                  rgba(229, 240, 255, 1);
    normal-foreground:           @foreground;
    alternate-normal-background: rgba(7, 7, 7, 0.17);
    red:                         rgba(220, 50, 47, 1);
    selected-urgent-foreground:  rgba(249, 249, 249, 1);
    blue:                        rgba(38, 139, 210, 1 );
    urgent-foreground:           rgba(204, 102, 102, 1);
    alternate-urgent-background: rgba(75, 81, 96, 1);
    active-foreground:           rgba(101, 172, 255, 1);
    lightbg:                     rgba(238, 232, 213, 1);
    selected-active-foreground:  rgba(249, 249, 249, 1);
    alternate-active-background: rgba(36, 38, 42, 1);
    background:                  rgba(10, 10, 10, 0.3);
    alternate-normal-foreground: @foreground;
    normal-background:           rgba(7, 7, 7, 0.0);
    selected-normal-background:  rgba(127, 127, 127, 0.3);
    border-color:                rgba( 124, 131, 137, 1);
    separatorcolor:              rgba( 29, 31, 33, 1);
    urgent-background:           rgba( 29, 31, 33, 0.3);
    selected-urgent-background:  rgb(12, 12, 12);
    alternate-urgent-foreground: @urgent-foreground;
    background-color:            rgba( 0, 0, 0, 0);
    alternate-active-foreground: @active-foreground;
    active-background:           rgba( 29, 31, 33, 0.3);
    selected-active-background:  rgb(23, 24, 25);
    spacing:                     0;
}

window {
    width:            650px;
    height:           500px;
    border:           0px;
	border-radius:    10px;
    background-color: rgba(20,21,23,0.75);
    padding:          5px;
}

mainbox {
    border:  0;
    padding: 0;
    children: [ inputbar, listview, mode-switcher ];
}

message {
    border:       20px 0px 0px ;
    border-color: @separatorcolor;
    padding:      1px ;
}

textbox {
    text-color: @foreground;
}

listview {
    fixed-height:  0;
    border:        0px 0px 0px;
    border-color:  @alternate-normal-background;
    spacing:       2px ;
    scrollbar:     true;
    padding:       1px 0px 0px ;
    border-radius: 6px;
}

element {
    border:        0;
    padding:       2px ;
    border-radius: 10px;
}

element-text, element-icon {
    background-color: inherit;
    text-color:       inherit;
}

element.normal.normal {
    background-color: @normal-background;
    text-color:       @normal-foreground;
}

element.normal.urgent {
    background-color: @urgent-background;
    text-color:       @urgent-foreground;
}

element.normal.active {
    background-color: @active-background;
    text-color:       @active-foreground;
}

element.selected.normal {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}

element.selected.urgent {
    background-color: @selected-urgent-background;
    text-color:       @selected-urgent-foreground;
}

element.selected.active {
    background-color: @selected-active-background;
    text-color:       @selected-active-foreground;
}

element.alternate.normal {
    background-color: @alternate-normal-background;
    text-color:       @alternate-normal-foreground;
}

element.alternate.urgent {
    background-color: @alternate-urgent-background;
    text-color:       @alternate-urgent-foreground;
}

element.alternate.active {
    background-color: @alternate-active-background;
    text-color: @alternate-active-foreground;
}

scrollbar {
    width: 1px;
    border: 0;
    handle-color: @normal-foreground;
    handle-width: 0px;
    padding: 0;
}

mode-switcher {
    border-color: @separatorcolor;
}

button {
    spacing:          10;
    border-radius:    6px;
    text-color:       @normal-foreground;
}

button.selected {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}

inputbar {
    spacing:    0;
    padding:    0px 0px 2px 5px;
    text-color: @normal-foreground;
}

case-indicator {
    spacing:    0;
    text-color: @normal-foreground;
}

entry {
    spacing:    0;
    text-color: @normal-foreground;
}

prompt {
    spacing:    0;
    text-color: @normal-foreground;
}

inputbar {
    children:   [ entry,case-indicator ];
}